    "editorBracketHighlight.foreground3": "#251B13",
    "editorBracketHighlight.foreground4": "#251B13",
    "editorBracketHighlight.foreground5": "#251B13",
    "editorBracketHighlight.foreground6": "#251B13",
    "editorBracketHighlight.unexpectedBracket.foreground": "#251B13"
