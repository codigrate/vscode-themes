  "tokenColors": [
    {
      "name": "Default text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#251B13"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7F8D78",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.function",
        "storage.type.const",
        "storage.type.let",
        "storage.type.var"
      ],
      "settings": {
        "foreground": "#98556C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double"
      ],
      "settings": {
        "foreground": "#875A9D"
      }
    },
    {
      "name": "Java method declarations",
      "scope": [
        "entity.name.function.java",
        "meta.method.identifier.java",
        "meta.method.declaration.java entity.name.function.java"
      ],
      "settings": {
        "foreground": "#251B13"
      }
    },
    {
      "name": "Number and constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#875A9D"
      }
    },
    {
      "name": "TypeScript function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "entity.name.function.ts",
        "entity.name.function.tsx",
        "meta.method.declaration.ts entity.name.function",
        "meta.method.declaration.tsx entity.name.function"
      ],
      "settings": {
        "foreground": "#251B13"
      }
    },
    {
      "name": "TypeScript class interface and type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.enum",
        "support.type",
        "support.class",
        "support.type.primitive.ts",
        "support.type.builtin.ts",
        "entity.name.type.class.ts",
        "entity.name.type.interface.ts",
        "entity.name.type.alias.ts"
      ],
      "settings": {
        "foreground": "#251B13"
      }
    },
    {
      "name": "TypeScript parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "variable.parameter.ts",
        "variable.parameter.tsx"
      ],
      "settings": {
        "foreground": "#CB6B91"
      }
    },
    {
      "name": "Java dots / separators",
      "scope": [
        "punctuation.separator.period.java",
        "punctuation.separator.java",
        "punctuation.accessor.java"
      ],
      "settings": {
        "foreground": "#251B13"
      }
    },
    {
      "name": "TypeScript local variable",
      "scope": [
        "variable.other.readwrite",
        "variable.other.readwrite.ts",
        "variable.other.readwrite.tsx",
        "variable.other.constant.ts",
        "variable.other.constant.tsx",
        "variable.other"
      ],
      "settings": {
        "foreground": "#618C71"
      }
    },
    {
      "name": "TypeScript property and field",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "variable.other.property.ts",
        "variable.other.property.tsx",
        "variable.other.object.property.ts",
        "variable.other.object.property.tsx",
        "variable.other.object.property.java",
        "variable.other.property.java",
        "variable.other.member.java",
        "entity.name.variable.field.java"
      ],
      "settings": {
        "foreground": "#607FA9"
      }
    },
    {
      "name": "TypeScript global variable",
      "scope": [
        "variable.other.global",
        "variable.other.global.ts",
        "variable.other.global.tsx"
      ],
      "settings": {
        "foreground": "#687788"
      }
    },
    {
      "name": "TypeScript static field",
      "scope": [
        "variable.other.constant.property",
        "support.constant.property",
        "variable.other.constant.property.ts",
        "variable.other.constant.property.tsx"
      ],
      "settings": {
        "foreground": "#69A2BD"
      }
    },
    {
      "name": "Annotation and metadata",
      "scope": [
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "meta.annotation",
        "entity.name.type.annotation",
        "meta.decorator",
        "meta.decorator.ts",
        "meta.decorator.tsx"
      ],
      "settings": {
        "foreground": "#B46E8D"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.expression",
        "keyword.operator.expression.typeof",
        "keyword.operator.expression.instanceof",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#251B13"
      }
    },
    {
      "name": "JSON property",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json.comments",
        "source.json support.type.property-name.json",
        "source.json support.type.property-name.json.comments",
        "meta.structure.dictionary.json support.type.property-name.json",
        "meta.structure.dictionary.json.comments support.type.property-name.json.comments"
      ],
      "settings": {
        "foreground": "#607FA9"
      }
    },
    {
      "name": "JSON property quotes",
      "scope": [
        "punctuation.support.type.property-name.begin.json",
        "punctuation.support.type.property-name.end.json",
        "punctuation.support.type.property-name.begin.json.comments",
        "punctuation.support.type.property-name.end.json.comments"
      ],
      "settings": {
        "foreground": "#607FA9"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value.css",
        "constant.other.color.rgb-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#875A9D"
      }
    },
    {
      "name": "JSON constants",
      "scope": [
        "constant.language.json",
        "constant.language.json.comments"
      ],
      "settings": {
        "foreground": "#98556C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#3A8E74"
      }
    },
    {
      "name": "CSS class selector",
      "scope": [
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#B46E8D"
      }
    },
    {
      "name": "CSS id selector",
      "scope": [
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#251B13"
      }
    },
    {
      "name": "CSS tag selector",
      "scope": [
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#B46E8D"
      }
    },
    {
      "name": "CSS pseudo classes",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-class.scss",
        "entity.other.attribute-name.pseudo-class.sass",
        "entity.other.attribute-name.pseudo-class.less"
      ],
      "settings": {
        "foreground": "#B46E8D"
      }
    },
    {
      "name": "CSS custom property name",
      "scope": [
        "variable.css",
        "variable.other.custom-property.css"
      ],
      "settings": {
        "foreground": "#3A8E74"
      }
    },
    {
      "name": "CSS font family values",
      "scope": [
        "support.constant.font-name.css",
        "support.constant.font-name.scss",
        "support.constant.font-name.sass",
        "support.constant.font-name.less",
        "meta.property-value.css support.constant.font-name",
        "meta.property-value.scss support.constant.font-name",
        "meta.property-value.less support.constant.font-name"
      ],
      "settings": {
        "foreground": "#875A9D"
      }
    },
    {
      "name": "JavaScript global variables",
      "scope": [
        "variable.other.readwrite.js",
        "variable.other.readwrite.jsx",
        "variable.other.readwrite.ts",
        "variable.other.readwrite.tsx",
        "variable.other.constant.js",
        "variable.other.constant.jsx",
        "variable.other.constant.ts",
        "variable.other.constant.tsx"
      ],
      "settings": {
        "foreground": "#687788"
      }
    },
    {
      "name": "HTML/XML attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#3A8E74"
      }
    },
    {
      "name": "TypeScript primitive types",
      "scope": [
        "support.type.primitive.ts",
        "support.type.primitive.tsx",
        "support.type.builtin.ts",
        "support.type.builtin.tsx",
        "keyword.type.ts",
        "keyword.type.tsx"
      ],
      "settings": {
        "foreground": "#98556C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML/XML attribute value",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html",
        "string.quoted.double.xml",
        "string.quoted.single.xml",
        "meta.attribute-with-value.html string",
        "meta.attribute-with-value.xml string"
      ],
      "settings": {
        "foreground": "#875A9D"
      }
    },
    {
      "name": "HTML/XML tag name",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml"
      ],
      "settings": {
        "foreground": "#B46E8D"
      }
    },
    {
      "name": "HTML/XML tag punctuation",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.xml"
      ],
      "settings": {
        "foreground": "#B46E8D"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#251B13",
    "type": "#251B13",
    "type.defaultLibrary": "#251B13",
    "typeParameter": "#CB6B91",
    "class": "#251B13",
    "class.defaultLibrary": "#251B13",
    "interface": "#251B13",
    "struct": "#251B13",
    "enum": "#251B13",
    "parameter": "#CB6B91",
    "variable.defaultLibrary": "#687788",
    "property": "#607FA9",
    "property.defaultLibrary": "#607FA9",
    "*.static": {
      "foreground": "#69A2BD",
      "fontStyle": "italic"
    },
    "property.static": {
      "foreground": "#69A2BD",
      "fontStyle": "italic"
    },
    "variable.static": {
      "foreground": "#69A2BD",
      "fontStyle": "italic"
    },
    "method.static": {
      "foreground": "#69A2BD",
      "fontStyle": "italic"
    },
    "function.static": {
      "foreground": "#69A2BD",
      "fontStyle": "italic"
    },
    "enumMember": "#251B13",
    "function": "#251B13",
    "function.defaultLibrary": "#251B13",
    "method": "#251B13",
    "method.defaultLibrary": "#251B13",
    "macro": "#B46E8D",
    "decorator": "#B46E8D",
    "keyword": {
      "foreground": "#98556C",
      "fontStyle": "bold"
    },
    "modifier": {
      "foreground": "#98556C",
      "fontStyle": "bold"
    },
    "comment": {
      "foreground": "#7F8D78",
      "fontStyle": "italic"
    },
    "string": "#875A9D",
    "number": "#875A9D",
    "regexp": "#875A9D",
    "operator": "#251B13",
    "*.deprecated": {
      "foreground": "#7F8D78",
      "fontStyle": "strikethrough"
    }
  }
}
